{
  "name": "sd-connect",
  "version": "0.1.0",
  "description": "Drive an Elgato Stream Deck MK.2 directly to show live herdr agent status",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/main.ts",
    "smoke": "node src/smoke.ts",
    "dump": "node src/render/dump.ts",
    "preview": "node src/render/preview.ts",
    "watch": "node src/herdr/watch.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@napi-rs/canvas": "^1.0.3",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5"
  }
}
