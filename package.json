{
  "name": "sd-connect",
  "version": "0.1.0",
  "description": "Drive an Elgato Stream Deck MK.2 directly to show live herdr agent status",
  "type": "module",
  "private": true,
  "module": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "smoke": "bun run src/smoke.ts",
    "dump": "bun run src/render/dump.ts",
    "preview": "bun run src/render/preview.ts",
    "watch": "bun run src/herdr/watch.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@napi-rs/canvas": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@julusian/jpeg-turbo"
  ]
}
